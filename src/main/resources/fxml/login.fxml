<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="rootPane"
      fx:controller="com.example.mef.demo.controller.LoginController"
      styleClass="login-root">

    <!-- Left brand panel -->
    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="login-brand-panel">
        <Label text="🏫" style="-fx-font-size: 64px;"/>
        <Label fx:id="brandLabel" style="-fx-font-size: 22px; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 0 0 0;"/>
        <Label fx:id="brandSubtitleLabel" style="-fx-font-size: 13px; -fx-text-fill: white; -fx-opacity: 0.85;"/>
    </VBox>

    <!-- Right form panel -->
    <StackPane HBox.hgrow="ALWAYS" styleClass="login-form-panel">
        <VBox alignment="CENTER_LEFT" spacing="14" maxWidth="360" styleClass="login-card">

            <!-- Language switcher -->
            <HBox alignment="CENTER_RIGHT" spacing="6" maxWidth="Infinity">
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="frButton" text="FR" styleClass="lang-button-active" onAction="#handleLangFr"/>
                <Button fx:id="arButton" text="DZ AR" styleClass="lang-button" onAction="#handleLangAr"/>
            </HBox>

            <!-- Trial-expired banner (hidden unless activated by controller) -->
            <VBox fx:id="trialBanner" spacing="10" visible="false" managed="false" styleClass="trial-expired-banner">
                <Label fx:id="trialBannerTitle" style="-fx-font-weight: bold; -fx-text-fill: #92400E;"/>
                <Label fx:id="trialBannerMessage" wrapText="true" style="-fx-text-fill: #92400E;"/>
                <Button fx:id="activateNowButton"
                        maxWidth="Infinity" styleClass="primary-button"
                        onAction="#handleActivateNow"/>
            </VBox>

            <Label fx:id="formSubtitle" styleClass="login-subtitle"/>

            <!-- Login fields -->
            <VBox fx:id="loginFields" spacing="10">
                <Label fx:id="emailLabel" styleClass="field-label"/>
                <TextField fx:id="usernameField" styleClass="login-field"/>
                <Label fx:id="passwordLabel" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" styleClass="login-field"/>
            </VBox>

            <!-- Register fields (hidden by default) -->
            <VBox fx:id="registerFields" spacing="10" visible="false" managed="false">
                <TextField fx:id="regNameField" styleClass="login-field"/>
                <TextField fx:id="regEmailField" styleClass="login-field"/>
                <PasswordField fx:id="regPasswordField" styleClass="login-field"/>
                <PasswordField fx:id="regConfirmField" styleClass="login-field"/>
                <ComboBox fx:id="regRoleCombo" maxWidth="Infinity" styleClass="login-field"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="login-error" visible="false" managed="false" wrapText="true"/>
            <Label fx:id="successLabel" styleClass="login-success" visible="false" managed="false" wrapText="true"/>

            <Button fx:id="primaryButton" defaultButton="true"
                    maxWidth="Infinity" styleClass="primary-button"
                    onAction="#handlePrimary"/>

            <Separator/>

            <HBox alignment="CENTER" spacing="8">
                <Label fx:id="toggleHint" styleClass="login-hint"/>
                <Button fx:id="toggleButton"
                        styleClass="link-button" onAction="#handleToggleMode"/>
            </HBox>
        </VBox>
    </StackPane>

</HBox>
