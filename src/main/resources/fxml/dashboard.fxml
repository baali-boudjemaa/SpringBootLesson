<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="rootPane"
            fx:controller="com.example.mef.demo.controller.DashboardController"
            styleClass="view-root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label fx:id="pageTitleLabel" text="Dashboard" styleClass="page-title"/>
            <Button fx:id="trialStatusButton" text="Version d'essai" styleClass="trial-status-button"
                    onAction="#openActivation" visible="false" managed="false"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Quick search trigger -->
            <Button fx:id="searchBarBtn" text="Recherche rapide...  Ctrl+K"
                    styleClass="search-bar-btn" onAction="#openGlobalSearchFromBtn">
                <graphic>
                    <FontIcon iconLiteral="fth-search" iconSize="14" iconColor="#64748B"/>
                </graphic>
            </Button>
            <Separator orientation="VERTICAL"/>
            <HBox fx:id="userChip" alignment="CENTER_LEFT" spacing="8" styleClass="user-chip">
                <StackPane styleClass="user-avatar">
                    <Label fx:id="userInitialsLabel" text="A" styleClass="user-avatar-text"/>
                </StackPane>
                <VBox spacing="0">
                    <Label fx:id="userNameLabel" styleClass="user-name"/>
                    <Label fx:id="userRoleLabel" styleClass="user-role"/>
                </VBox>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <!-- Language switcher -->
            <Button fx:id="frButton" text="FR" styleClass="lang-button-active" onAction="#handleLangFr"/>
            <Button fx:id="arButton" text="DZ AR" styleClass="lang-button" onAction="#handleLangAr"/>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="backupButton" text="Sauvegarder" styleClass="secondary-button" onAction="#handleBackup">
                <graphic>
                    <FontIcon iconLiteral="fth-save" iconSize="14"/>
                </graphic>
            </Button>
            <Button fx:id="restoreButton" text="Restaurer" styleClass="secondary-button" onAction="#handleRestore">
                <graphic>
                    <FontIcon iconLiteral="fth-upload-cloud" iconSize="14"/>
                </graphic>
            </Button>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="logoutButton" text="Déconnexion" styleClass="secondary-button" onAction="#handleLogout">
                <graphic>
                    <FontIcon iconLiteral="fth-log-out" iconSize="14"/>
                </graphic>
            </Button>
        </HBox>
    </top>
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" styleClass="sidebar-brand-box">
                <VBox fx:id="brandTextBox" spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="brandLabel" text="Rawdati" styleClass="brand-label"/>
                    <Label fx:id="brandSubtitleLabel" text="Gestion de Crèche" styleClass="brand-subtitle"/>
                </VBox>
                <Button fx:id="sidebarToggleButton" styleClass="sidebar-toggle-button" onAction="#toggleSidebar">
                    <graphic>
                        <FontIcon fx:id="sidebarToggleIcon" iconLiteral="fth-chevrons-left" iconSize="16" iconColor="#94A3B8"/>
                    </graphic>
                </Button>
            </HBox>
            <ScrollPane fx:id="sidebarScroll" styleClass="sidebar-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                <VBox fx:id="navigationBox" spacing="2">
                    <padding>
                        <Insets top="8" right="10" bottom="18" left="10"/>
                    </padding>
                </VBox>
            </ScrollPane>
        </VBox>
    </left>

    <center>
        <BorderPane fx:id="contentPane" styleClass="content-area"/>
    </center>

</BorderPane>
