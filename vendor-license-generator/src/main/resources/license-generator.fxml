<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.rawdati.licensing.dashboardController"
            fitToWidth="true"
            style="-fx-padding: 0;">

    <VBox spacing="20" style="-fx-padding: 30;">

        <!-- Header -->
        <VBox spacing="5">
            <Label text="License Key Generator" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
            <Label text="Vendor-only utility. Generate RSA-signed activation keys for customers."
                   style="-fx-font-size: 12; -fx-text-fill: #666;"/>
        </VBox>

        <Separator/>

        <!-- Input Section -->
        <VBox spacing="15" style="-fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-padding: 20;">
            <Label text="Key Details" style="-fx-font-size: 14; -fx-font-weight: bold;"/>

            <!-- Machine ID -->
            <VBox spacing="5">
                <Label text="Machine ID *" style="-fx-font-weight: bold;"/>
                <TextField fx:id="machineIdField"
                           promptText="e.g., 358c1234-5678-90ab-cdef-1234567890ab"
                           style="-fx-font-size: 11;"/>
                <Label text="The unique identifier of the customer's machine"
                       style="-fx-font-size: 10; -fx-text-fill: #999;"/>
            </VBox>

            <!-- Private Key -->
            <VBox spacing="5">
                <Label text="Private Key File *" style="-fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <TextField fx:id="privateKeyPathField"
                               promptText="Path to private_key.der"
                               HBox.hgrow="ALWAYS"
                               editable="false"
                               style="-fx-font-size: 11;"/>
                    <Button fx:id="browseButton"
                            text="Browse..."
                            prefWidth="100"
                            style="-fx-font-size: 11;"/>
                </HBox>
                <Label text="PKCS8 RSA private key (DER format)"
                       style="-fx-font-size: 10; -fx-text-fill: #999;"/>
            </VBox>

            <!-- License Plan -->
            <VBox spacing="5">
                <Label text="License Plan *" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="planComboBox"
                          prefWidth="200"
                          style="-fx-font-size: 11;"/>
                <Label text="Duration of the license validity"
                       style="-fx-font-size: 10; -fx-text-fill: #999;"/>
            </VBox>
        </VBox>

        <!-- Generate Button -->
        <HBox>
            <Button fx:id="generateButton"
                    text="Generate Key"
                    style="-fx-font-size: 12; -fx-padding: 10 30;"
                    prefHeight="40"/>
            <Label fx:id="statusLabel"
                   text="Ready"
                   HBox.hgrow="ALWAYS"
                   style="-fx-text-fill: #666; -fx-padding: 0 15;"/>
        </HBox>

        <!-- Result Section -->
        <VBox fx:id="resultContainer"
              spacing="15"
              style="-fx-border-color: #e8f5e9; -fx-border-radius: 4; -fx-padding: 20; -fx-background-color: #f1f8f6;">

            <Label text="Activation Key" style="-fx-font-size: 14; -fx-font-weight: bold;"/>

            <!-- Expiration Date -->
            <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #e8f5e9; -fx-border-radius: 4;">
                <Label text="✓" style="-fx-font-size: 14; -fx-text-fill: #2e7d32;"/>
                <Label fx:id="expirationDateLabel"
                       text="Valid until: 2024-01-15 (Monthly)"
                       style="-fx-font-size: 12;"/>
            </HBox>

            <!-- Activation Key Display -->
            <VBox spacing="5">
                <Label text="Share this key with the customer:"
                       style="-fx-font-size: 11; -fx-text-fill: #666;"/>
                <TextArea fx:id="activationKeyDisplay"
                          wrapText="true"
                          prefRowCount="6"
                          style="-fx-font-family: monospace; -fx-font-size: 10; -fx-control-inner-background: #fafafa;"/>
            </VBox>

            <!-- Copy Button -->
            <HBox>
                <Button fx:id="copyButton"
                        text="Copy to Clipboard"
                        style="-fx-font-size: 11; -fx-padding: 8 20;"/>
            </HBox>
        </VBox>

        <VBox VBox.vgrow="ALWAYS"/>

        <!-- Footer -->
        <VBox spacing="5" style="-fx-padding: 20 0 0 0; -fx-border-color: #e0e0e0 transparent transparent transparent;">
            <Label text="Security Notice" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
            <Label text="This utility requires the vendor's private key. Never share this tool or the private key with customers. Generate keys only in a secure environment."
                   wrapText="true"
                   style="-fx-font-size: 10; -fx-text-fill: #d97757;"/>
        </VBox>

    </VBox>

</ScrollPane>
